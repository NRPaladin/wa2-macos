!/WA2-macOS-local/source/shader/
!/WA2-macOS-local/source/tools/
/WA2-macOS-local/source/tools/*
!/WA2-macOS-local/source/tools/pak.py
!/WA2-macOS-local/source/tools/prepare_assets.py
!/WA2-macOS-local/source/tools/prepare_movies.py
!/WA2-macOS-local/source/tools/extract_windows_icon.py
!/WA2-macOS-local/source/tools/build_macos.sh
!/WA2-macOS-local/source/tools/play_muted.sh
!/WA2-macOS-local/source/tools/test_macos.sh
!/WA2-macOS-local/source/tools/verify_bundle.py
!/WA2-macOS-local/source/tools/verify_resources.py
