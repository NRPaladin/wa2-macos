# SPDX-License-Identifier: MIT
# This workspace also contains private game data and full local installers.
# Admit only explicitly selected source components into Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/NOTICE
!/CHANGES.md
!/THIRD_PARTY_NOTICES.md
!/LICENSES/
/LICENSES/*
!/LICENSES/MIT.txt
!/tools/
/tools/*
!/tools/verify_repository.py
!/tools/prepare_owned_resources.py
!/.githooks/
/.githooks/*
!/.githooks/pre-commit
!/WA2-macOS-local/
/WA2-macOS-local/*
!/WA2-macOS-local/source/
/WA2-macOS-local/source/*
!/WA2-macOS-local/source/LICENSE
!/WA2-macOS-local/source/NOTICE
!/WA2-macOS-local/source/LICENSES/
!/WA2-macOS-local/source/ASSET_POLICY.md
!/WA2-macOS-local/source/PORTING_CODE.md
!/WA2-macOS-local/source/SUBTITLE_NOTICE.md
!/WA2-macOS-local/source/THIRD_PARTY_NOTICES.md
!/WA2-macOS-local/source/NuGet.Config
!/WA2-macOS-local/source/global.json
